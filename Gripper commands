import socket, time

ROBOT_IP = "192.168.123.3"
PORT = 63352

def cmd(s, text):
    s.sendall((text + "\n").encode())
    time.sleep(0.1)
    try:
        print(text, "->", s.recv(1024).decode(errors="ignore").strip())
    except socket.timeout:
        print(text, "-> no reply")

with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
    s.settimeout(2)
    s.connect((ROBOT_IP, PORT))

    # Activate
    cmd(s, "SET ACT 1")
    cmd(s, "SET GTO 1")
    cmd(s, "SET SPE 150")
    cmd(s, "SET FOR 150")
    time.sleep(1.0)

    print("Status:")
    cmd(s, "GET STA")
    cmd(s, "GET POS")
    cmd(s, "GET FLT")

    print("Closing...")
    cmd(s, "SET POS 255")
    time.sleep(2.0)
    cmd(s, "GET POS")
    cmd(s, "GET OBJ")

    print("Opening...")
    cmd(s, "SET POS 0")
    time.sleep(2.0)
    cmd(s, "GET POS")
    cmd(s, "GET OBJ")
